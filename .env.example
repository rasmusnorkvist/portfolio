# Copy this file to .env and fill in real values for local testing.
# Never commit the real .env file, see README.md > "My Music setup".

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Optional: comma-separated Spotify playlist IDs, overrides the
# DEFAULT_FEATURED_PLAYLIST_IDS list in scripts/fetch-spotify-data.mjs.
SPOTIFY_FEATURED_PLAYLISTS=

# Optional: comma-separated artist names to hide from every list on the
# site, overrides the DEFAULT_EXCLUDED_ARTIST_NAMES list in
# scripts/fetch-spotify-data.mjs.
SPOTIFY_EXCLUDED_ARTISTS=
